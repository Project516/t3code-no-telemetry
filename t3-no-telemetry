#!/usr/bin/env bash
# Turns off T3 Code product analytics and relay tracing on a Linux machine.
# Usage: t3-no-telemetry [--uninstall]. Safe to rerun. Restart T3 Code afterwards.
set -euo pipefail

policy=/etc/t3code/policy.json
dropin="$HOME/.config/systemd/user/t3code.service.d/telemetry.conf"
marker="# t3-no-telemetry"
blocked_hosts=(ingest.t3.codes us-east-1.aws.edge.axiom.co)
shell_rcs=("$HOME/.bashrc" "$HOME/.zshrc")
env_vars=(T3CODE_TELEMETRY_ENABLED=false T3CODE_OTEL_SDK_DISABLED=true DO_NOT_TRACK=1)

[ "$(uname -s)" = Linux ] || { echo "Linux only. See the README for macOS and Windows." >&2; exit 1; }

policy_json='{
  "schemaVersion": 1,
  "organization": "t3code-no-telemetry",
  "limits": { "telemetry": false }
}'

has_service() { systemctl --user cat t3code.service >/dev/null 2>&1; }

# Removes the block between the markers, and the two-line block older versions wrote without an end marker.
strip_rc_block() {
  local tmp
  tmp=$(mktemp)
  awk -v m="$marker" -v n="${#env_vars[@]}" '{ l[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        if (l[i] == m && l[i + n + 1] == m " end") { i += n + 1; continue }
        if (l[i] == m && l[i + 1] == "export T3CODE_TELEMETRY_ENABLED=false" &&
          l[i + 2] == "export T3CODE_OTEL_SDK_DISABLED=true") { i += 2; continue }
        print l[i]
      }
    }' "$1" >"$tmp"
  cat "$tmp" >"$1"
  rm -f "$tmp"
}

# With cloud-init managing /etc/hosts, it rewrites the file from the template named in its header at every boot.
hosts_files() {
  echo /etc/hosts
  local tmpl
  tmpl=$(grep -oE '/etc/cloud/templates/hosts\.[a-z0-9]+\.tmpl' /etc/hosts | head -1) || true
  if [ -n "$tmpl" ] && [ -f "$tmpl" ]; then echo "$tmpl"; fi
}

enable() {
  if [ -e "$policy" ]; then
    if grep -qE '"telemetry"[[:space:]]*:[[:space:]]*false' "$policy"; then
      echo "$policy already turns telemetry off; leaving it as is."
    else
      echo "$policy exists. Add \"telemetry\": false under \"limits\" by hand, then rerun." >&2
      exit 1
    fi
  else
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$policy_json" >"$tmp"
    if command -v t3 >/dev/null; then t3 policy check "$tmp" >/dev/null; fi
    sudo install -D -o root -g root -m 0644 "$tmp" "$policy"
    sudo chmod 0755 "$(dirname "$policy")"
  fi

  # The policy covers the server and desktop app. The env vars are a second layer.
  if has_service; then
    mkdir -p "$(dirname "$dropin")"
    { echo '[Service]'; printf 'Environment=%s\n' "${env_vars[@]}"; } >"$dropin"
    systemctl --user daemon-reload
  fi

  # The desktop app imports only T3CODE_TELEMETRY_ENABLED and DO_NOT_TRACK from the login shell.
  for rc in "${shell_rcs[@]}"; do
    [ -f "$rc" ] || continue
    grep -qxF "$marker" "$rc" && strip_rc_block "$rc"
    [ -z "$(tail -c1 "$rc")" ] || echo >>"$rc"
    { echo "$marker"; printf 'export %s\n' "${env_vars[@]}"; echo "$marker end"; } >>"$rc"
  done

  # Browsers ignore the policy and env vars, so block their trace host here.
  local f host addr
  while read -r f; do
    [ -z "$(tail -c1 "$f")" ] || echo | sudo tee -a "$f" >/dev/null
    for host in "${blocked_hosts[@]}"; do
      for addr in 0.0.0.0 ::; do
        grep -qxF "$addr $host $marker" "$f" ||
          echo "$addr $host $marker" | sudo tee -a "$f" >/dev/null
      done
    done
  done < <(hosts_files)

  echo "Done. Restart T3 Code, then run: t3 policy show"
}

disable() {
  if [ -e "$policy" ]; then
    if [ "$(cat "$policy")" = "$policy_json" ]; then
      sudo rm "$policy"
      sudo rmdir "$(dirname "$policy")" 2>/dev/null || true
    else
      echo "$policy was not written by this script; leaving it." >&2
    fi
  fi

  if [ -e "$dropin" ]; then
    rm "$dropin"
    rmdir --ignore-fail-on-non-empty "$(dirname "$dropin")"
    if has_service; then systemctl --user daemon-reload; fi
  fi

  for rc in "${shell_rcs[@]}"; do
    if [ -f "$rc" ] && grep -qxF "$marker" "$rc"; then strip_rc_block "$rc"; fi
  done

  # cp writes into the existing file: /etc/hosts can be a bind mount, which sed -i cannot replace.
  local f kept
  kept=$(mktemp)
  while read -r f; do
    if grep -qF " $marker" "$f"; then
      grep -vF " $marker" "$f" >"$kept"
      sudo cp "$kept" "$f"
    fi
  done < <(hosts_files)
  rm -f "$kept"

  echo "Removed. Restart T3 Code to apply."
}

case "${1:-}" in
  "") enable ;;
  --uninstall) disable ;;
  *) echo "Usage: $0 [--uninstall]" >&2; exit 2 ;;
esac
